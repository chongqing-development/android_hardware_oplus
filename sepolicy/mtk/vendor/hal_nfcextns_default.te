# hal_nfcextns_default - ported from the stock vendor policy

type hal_nfcextns_default, domain;
hal_server_domain(hal_nfcextns_default, hal_nfcextns)
typeattribute hal_nfcextns_default mlstrustedsubject;

type hal_nfcextns_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_nfcextns_default)

allow hal_nfcextns_default nfc_device:chr_file rw_file_perms;
