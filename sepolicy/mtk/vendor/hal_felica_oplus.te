# hal_felica_oplus - ported from the stock vendor policy

type hal_felica_oplus, domain;
hal_server_domain(hal_felica_oplus, hal_felica)

type hal_felica_oplus_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_felica_oplus)

allow hal_felica_oplus hal_felica_hwservice:hwservice_manager { add find };
allow hal_felica_oplus hidl_base_hwservice:hwservice_manager { add };
allow hal_felica_oplus mnt_vendor_file:dir { add_name append getattr ioctl lock map open read remove_name rmdir search watch watch_reads write };
allow hal_felica_oplus nfc_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow hal_felica_oplus oplus_reserve_connectivity_felicalock:dir { add_name append create getattr ioctl lock map open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow hal_felica_oplus oplus_reserve_connectivity_felicalock:file create_file_perms;
allow hal_felica_oplus oplus_reserve_connectivity_file:dir { search };
allow hal_felica_oplus oplus_reserve_file:dir { add_name create getattr open read remove_name search write };
allow hal_felica_oplus oplus_reserve_file:file create_file_perms;
allow hal_felica_oplus tee_device:chr_file { ioctl open read write };
