# Rules for hal_secure_element_default touching device types

allow hal_secure_element_default eventprocessor_hwservice:hwservice_manager { add find };
allow hal_secure_element_default hal_oplus_nfc_default:binder { call transfer };
allow hal_secure_element_default nxpese_hwservice:hwservice_manager { add find };
allow hal_secure_element_default nxpnfc_hwservice:hwservice_manager { add find };
allow hal_secure_element_default secure_element_vendor_data_file:dir { add_name remove_name search write };
allow hal_secure_element_default secure_element_vendor_data_file:file { append create getattr open read setattr unlink write };
allow hal_secure_element_default vendor_nfc_vendor_data_file:dir { search };
allow hal_secure_element_default vendor_nfc_vendor_data_file:file { getattr open read setattr unlink write };
