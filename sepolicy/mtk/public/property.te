# Types for the shipped OPPO/MTK properties that no rule labelled, so they used
# to live in the unlabelled default_prop / vendor_default_prop areas.  There no
# allow rule is possible at all (platform neverallows block a vendor domain from
# the system-internal areas and a coredomain from the vendor-internal one), while
# a system_public_prop may be read by both - see private/property_access.te for
# the coredomain side and the HALs' own vendor/*.te for the get_prop() side.
system_public_prop(oplus_project_config_prop)
system_public_prop(oplus_camera_config_prop)
system_public_prop(oplus_audio_config_prop)
system_public_prop(oplus_wfd_debug_prop)
system_public_prop(mtk_bluetooth_config_prop)
system_public_prop(mtk_smvr_config_prop)
system_public_prop(mtk_display_debug_prop)
system_public_prop(qti_va_aosp_support_prop)
system_public_prop(mtk_assert_config_prop)
system_public_prop(mtk_feature_flag_prop)
system_public_prop(device_config_generic_prop)
