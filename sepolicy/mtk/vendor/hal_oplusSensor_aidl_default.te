# hal_oplusSensor_aidl_default - ported from the stock vendor policy

type hal_oplusSensor_aidl_default, domain;
hal_server_domain(hal_oplusSensor_aidl_default, hal_oplusSensor_aidl)

type hal_oplusSensor_aidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_oplusSensor_aidl_default)

allow hal_oplusSensor_aidl_default als_ps_device:chr_file r_file_perms;
allow hal_oplusSensor_aidl_default block_device:dir { search };
allow hal_oplusSensor_aidl_default gsensor_device:chr_file r_file_perms;
allow hal_oplusSensor_aidl_default gyroscope_device:chr_file r_file_perms;
allow hal_oplusSensor_aidl_default hf_manager_device:chr_file rw_file_perms;
allow hal_oplusSensor_aidl_default mnt_vendor_file:dir { search };
allow hal_oplusSensor_aidl_default msensor_device:chr_file r_file_perms;
allow hal_oplusSensor_aidl_default nvcfg_file:dir create_dir_perms;
allow hal_oplusSensor_aidl_default nvcfg_file:file create_file_perms;
allow hal_oplusSensor_aidl_default nvdata_file:dir create_dir_perms;
allow hal_oplusSensor_aidl_default nvdata_file:file create_file_perms;
allow hal_oplusSensor_aidl_default nvdata_file:lnk_file r_file_perms;
allow hal_oplusSensor_aidl_default oplus_block_device:blk_file { open read write };
allow hal_oplusSensor_aidl_default oplus_block_device:dir r_dir_perms;
allow hal_oplusSensor_aidl_default oplus_block_device:file { getattr ioctl lock open read watch watch_reads };
allow hal_oplusSensor_aidl_default oplus_block_device:lnk_file r_file_perms;
allow hal_oplusSensor_aidl_default oplus_sensor_sys_file:dir r_dir_perms;
allow hal_oplusSensor_aidl_default oplus_sensor_sys_file:file { append create getattr ioctl lock map open read setattr unlink watch watch_reads write };
allow hal_oplusSensor_aidl_default oplus_sysfs:file { open write };
allow hal_oplusSensor_aidl_default persist_camera_file:dir rw_dir_perms;
allow hal_oplusSensor_aidl_default persist_camera_file:file create_file_perms;
allow hal_oplusSensor_aidl_default persist_camera_file:lnk_file r_file_perms;
allow hal_oplusSensor_aidl_default persist_engineer_file:dir { add_name search write };
allow hal_oplusSensor_aidl_default persist_engineer_file:file { create getattr open read write };
allow hal_oplusSensor_aidl_default proc_eng_cali_file:dir r_dir_perms;
allow hal_oplusSensor_aidl_default proc_eng_cali_file:file rw_file_perms;
allow hal_oplusSensor_aidl_default proc_oplus_als_file:dir r_dir_perms;
allow hal_oplusSensor_aidl_default proc_oplus_als_file:file rw_file_perms;
allow hal_oplusSensor_aidl_default proc_oplus_sensor_file:dir r_dir_perms;
allow hal_oplusSensor_aidl_default proc_oplus_sensor_file:file { append create getattr ioctl lock map open read setattr unlink watch watch_reads write };
allow hal_oplusSensor_aidl_default proc_opluscustom_file:dir r_dir_perms;
allow hal_oplusSensor_aidl_default proc_opluscustom_file:file { getattr ioctl lock map open read watch watch_reads write };
allow hal_oplusSensor_aidl_default proc_opluscustom_file:lnk_file r_file_perms;
allow hal_oplusSensor_aidl_default proc_sensor_feature:dir r_dir_perms;
allow hal_oplusSensor_aidl_default proc_sensor_feature:file rw_file_perms;
allow hal_oplusSensor_aidl_default servicemanager:binder { call transfer };
r_dir_file(hal_oplusSensor_aidl_default, persist_data_file)
r_dir_file(hal_oplusSensor_aidl_default, proc_devinfo_file)

add_service(hal_oplusSensor_aidl_default, hal_oplusSensor_aidl_service)
get_prop(hal_oplusSensor_aidl_default, vendor_oplus_prop)
