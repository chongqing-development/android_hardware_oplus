# hal_oplus_touch_aidl_default - ported from the stock vendor policy

type hal_oplus_touch_aidl_default, domain;
hal_server_domain(hal_oplus_touch_aidl_default, hal_oplus_touch_aidl)
typeattribute hal_oplus_touch_aidl_default mlstrustedsubject;

type hal_oplus_touch_aidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_oplus_touch_aidl_default)

allow hal_oplus_touch_aidl_default atsdaemond2_socket:sock_file { open read write };
allow hal_oplus_touch_aidl_default bluetooth:binder { call };
allow hal_oplus_touch_aidl_default fuse:dir { add_name create search write };
allow hal_oplus_touch_aidl_default fuse:file { create open read write };
allow hal_oplus_touch_aidl_default hal_fingerprint_oplus:binder { transfer };
allow hal_oplus_touch_aidl_default hal_health_default:binder { transfer };
allow hal_oplus_touch_aidl_default hal_oplus_touch_aidl_service:service_manager { add find };
allow hal_oplus_touch_aidl_default mnt_user_file:dir { search };
allow hal_oplus_touch_aidl_default mnt_user_file:lnk_file { read };
allow hal_oplus_touch_aidl_default proc_devinfo_file:chr_file { ioctl open read write };
allow hal_oplus_touch_aidl_default proc_devinfo_file:dir r_dir_perms;
allow hal_oplus_touch_aidl_default proc_devinfo_file:file { create getattr ioctl lock map open read setattr unlink watch watch_reads write };
allow hal_oplus_touch_aidl_default proc_touchpanel_file:chr_file { ioctl open read write };
allow hal_oplus_touch_aidl_default proc_touchpanel_file:dir r_dir_perms;
allow hal_oplus_touch_aidl_default proc_touchpanel_file:file { create getattr ioctl lock map open read setattr unlink watch watch_reads write };
allow hal_oplus_touch_aidl_default proc_tristatekey:chr_file { ioctl open read write };
allow hal_oplus_touch_aidl_default proc_tristatekey:dir r_dir_perms;
allow hal_oplus_touch_aidl_default proc_tristatekey:file { create getattr ioctl lock map open read setattr unlink watch watch_reads write };
allow hal_oplus_touch_aidl_default servicemanager:binder { call transfer };
allow hal_oplus_touch_aidl_default socket_device:dir { add_name create getattr open read remove_name setattr unlink write };
allow hal_oplus_touch_aidl_default socket_device:sock_file { create getattr open read setattr unlink write };
allow hal_oplus_touch_aidl_default system_server:binder { call };
allow hal_oplus_touch_aidl_default touchDeamonBinder_service:service_manager { find };
allow hal_oplus_touch_aidl_default tp_device:chr_file { getattr ioctl open read write };
allow hal_oplus_touch_aidl_default vndbinder_device:chr_file { ioctl map open read write };
allow hal_oplus_touch_aidl_default vndservicemanager:binder { call };
