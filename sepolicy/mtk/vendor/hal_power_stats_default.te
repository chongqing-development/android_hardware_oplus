# Rules for hal_power_stats_default touching device types

allow hal_power_stats_default oplus_abnormal_task:file { open read write };
allow hal_power_stats_default oplus_binder_stats_device:chr_file { open read };
allow hal_power_stats_default oplus_charger_proc:file rw_file_perms;
allow hal_power_stats_default hal_oplus_handle_factory_service:service_manager { add find };
allow hal_power_stats_default oplus_project_proc:file r_file_perms;
allow hal_power_stats_default oplus_rpmh_stats_proc:file rw_file_perms;
allow hal_power_stats_default proc_power:file r_file_perms;
allow hal_power_stats_default oplus_sysfs:dir { search };
allow hal_power_stats_default oplus_sysfs:file { open read write };
allow hal_power_stats_default proc_devinfo_file:chr_file { ioctl open read write };
allow hal_power_stats_default proc_devinfo_file:dir { getattr open read search };
allow hal_power_stats_default proc_devinfo_file:file { create getattr open read setattr unlink write };
allow hal_power_stats_default sysfs_battery_supply:dir r_dir_perms;
allow hal_power_stats_default sysfs_battery_supply:file r_file_perms;
allow hal_power_stats_default sysfs_oplus_zram:dir { search };
allow hal_power_stats_default sysfs_oplus_zram:file r_file_perms;
allow hal_power_stats_default sysfs_ufs_trans_file:file r_file_perms;
allow hal_power_stats_default vendor_proc_charger:file rw_file_perms;
allow hal_power_stats_default vendor_configs_file:dir r_dir_perms;
allow hal_power_stats_default vendor_configs_file:file r_file_perms;
