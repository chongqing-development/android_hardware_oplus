# Rules for mtk_hal_c2 touching device types

allow mtk_hal_c2 hal_oplus_performance_aidl:binder { call transfer };
allow mtk_hal_c2 hal_oplus_performance_aidl:fd { use };
allow mtk_hal_c2 hal_oplus_performance_aidl_service:service_manager { find };
allow mtk_hal_c2 oplus_vcodecdump_file:dir { add_name create getattr open read remove_name rmdir search write };
allow mtk_hal_c2 oplus_vcodecdump_file:file { append create getattr ioctl lock map open read setattr unlink watch watch_reads write };
get_prop(mtk_hal_c2, vendor_mtk_c2_gpu_fmt_prop)
set_prop(mtk_hal_c2, vendor_oplus_prop)

# Same display/HDR/DVFS switches as mtk_hal_camera (see that file).
get_prop(mtk_hal_c2, mtk_display_debug_prop)

# The codec2 HAL reads the boot-mode node (genfscon sysfs
# /devices/virtual/BOOT/BOOT/boot/boot_mode -> sysfs_boot_mode, declared in
# device/mediatek/sepolicy_vndr) from its post-processing thread, which is how
# every other MTK daemon had it and it did not.
allow mtk_hal_c2 sysfs_boot_mode:file r_file_perms;
