r_dir_file(hal_audio_default, vendor_proc_oplus_version)

hal_client_domain(hal_audio_default, vendor_hal_oplus_performance)

binder_call(hal_audio_default, hal_oplus_performance_aidl)

r_dir_file(hal_audio_default, sysfs_batteryinfo)
r_dir_file(hal_audio_default, sysfs_power_supply)

get_prop(hal_audio_default, boot_status_prop)
get_prop(hal_audio_default, system_oplus_project_prop)
set_prop(hal_audio_default, system_oplus_audio_prop)
set_prop(hal_audio_default, vendor_audio_tuning_prop)

allow hal_audio_default persist_data_file:dir search;
