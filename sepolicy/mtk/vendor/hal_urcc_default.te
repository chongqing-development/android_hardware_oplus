# URCC registers its own AIDL service and is a performance scheduler, so it
# locks memory and asks for a nice level.
add_service(hal_urcc_default, hal_urcc_service)
allow hal_urcc_default servicemanager:binder { call transfer };
allow hal_urcc_default self:capability { ipc_lock sys_nice };
