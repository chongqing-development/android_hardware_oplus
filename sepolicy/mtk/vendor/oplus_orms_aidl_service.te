# oplus_orms_aidl_service - ported from the stock vendor policy

type oplus_orms_aidl_service, domain;

type oplus_orms_aidl_service_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(oplus_orms_aidl_service)

allow oplus_orms_aidl_service dumpstate:binder { transfer };
allow oplus_orms_aidl_service oplus_eas_opt:file rw_file_perms;
allow oplus_orms_aidl_service oplus_iowait_config:file rw_file_perms;
allow oplus_orms_aidl_service oplus_orms_aidl_hal_service:service_manager { add find };
allow oplus_orms_aidl_service oplus_prefer_silver_proc:file rw_file_perms;
allow oplus_orms_aidl_service oplus_scheduler_sched_assist_proc:dir { search };
allow oplus_orms_aidl_service oplus_scheduler_sched_assist_proc:file { open write };
allow oplus_orms_aidl_service proc_fbg_sysctl:file rw_file_perms;
allow oplus_orms_aidl_service proc_mcdi:dir r_dir_perms;
allow oplus_orms_aidl_service proc_mcdi:file rw_file_perms;
allow oplus_orms_aidl_service proc_perfmgr:dir r_dir_perms;
allow oplus_orms_aidl_service proc_perfmgr:file rw_file_perms;
allow oplus_orms_aidl_service proc_slide_enable:file rw_file_perms;
allow oplus_orms_aidl_service proc_version:file { getattr open read };
allow oplus_orms_aidl_service servicemanager:binder { call transfer };
allow oplus_orms_aidl_service skip_goplus_enabled:file rw_file_perms;
allow oplus_orms_aidl_service sysfs:file { open read write };
allow oplus_orms_aidl_service sysfs_devices_system_cpu:dir r_dir_perms;
allow oplus_orms_aidl_service sysfs_devices_system_cpu:file rw_file_perms;
allow oplus_orms_aidl_service sysfs_fbt_cpu:dir r_dir_perms;
allow oplus_orms_aidl_service sysfs_fbt_cpu:file rw_file_perms;
allow oplus_orms_aidl_service sysfs_fpsgo:dir r_dir_perms;
allow oplus_orms_aidl_service sysfs_fpsgo:file rw_file_perms;
allow oplus_orms_aidl_service sysfs_thermal:file { write };
allow oplus_orms_aidl_service sysfs_xgf:dir r_dir_perms;
allow oplus_orms_aidl_service sysfs_xgf:file rw_file_perms;
allow oplus_orms_aidl_service system_server:binder { call transfer };
allow oplus_orms_aidl_service system_server:fd { use };
