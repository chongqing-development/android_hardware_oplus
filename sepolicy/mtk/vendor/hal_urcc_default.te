# hal_urcc_default - ported from the stock vendor policy

type hal_urcc_default, domain;
hal_server_domain(hal_urcc_default, hal_urcc)
typeattribute hal_urcc_default mlstrustedsubject;

type hal_urcc_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_urcc_default)

