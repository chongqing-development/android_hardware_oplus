# The proc nodes labelled by genfs_contexts are (re)created at runtime by their
# drivers; without this the kernel refuses to associate the label with procfs and
# the file keeps the generic proc label.
allow proc_type proc:filesystem associate;

# The kernel's dmabuf pseudo-filesystem (drivers/dma-buf/dma-buf.c, mounted
# internally via kern_mount, so it never shows in /proc/mounts).  Its root was
# unlabeled, which made every statfs() on a dmabuf-backed path from an app a
# `untrusted_app -> unlabeled:filesystem getattr` denial; the platform already
# holds `allow domain fs_type:filesystem getattr`, so an fs_type label is all
# that is needed - the label itself lives in genfs_contexts.
type dmabuf_fs, fs_type;
