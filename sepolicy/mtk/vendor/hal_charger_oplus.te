# hal_charger_oplus - ported from the stock vendor policy

type hal_charger_oplus, domain;
hal_server_domain(hal_charger_oplus, hal_charger)
hal_client_domain(hal_charger_oplus, hal_cryptoeng)

type hal_charger_oplus_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_charger_oplus)

allow hal_charger_oplus block_device:dir { search };
allow hal_charger_oplus block_device:file { getattr open read write };
allow hal_charger_oplus fwk_osense_aidl_service:service_manager { find };
allow hal_charger_oplus fwk_sensor_hwservice:hwservice_manager { find };
allow hal_charger_oplus hal_charger_service:service_manager { add find };
allow hal_charger_oplus init:unix_stream_socket { connectto read write };
allow hal_charger_oplus oplus_battery_log_file:dir create_dir_perms;
allow hal_charger_oplus oplus_battery_log_file:file create_file_perms;
allow hal_charger_oplus oplus_block_device:blk_file { open read write };
allow hal_charger_oplus oplus_charger_cycle_proc:file rw_file_perms;
allow hal_charger_oplus oplus_charger_dev:chr_file rw_file_perms;
allow hal_charger_oplus oplus_charger_log_proc:file rw_file_perms;
allow hal_charger_oplus oplus_charger_proc:file rw_file_perms;
allow hal_charger_oplus oplus_chg_test_kit_device:chr_file { ioctl open read write };
allow hal_charger_oplus oplus_integrate_gauge_fcc_flag_proc:file rw_file_perms;
allow hal_charger_oplus oplus_ui_soc_decimal_proc:file rw_file_perms;
allow hal_charger_oplus platform_app:binder { transfer };
allow hal_charger_oplus proc_devinfo_file:dir { search };
allow hal_charger_oplus procfs_oem_wireless:dir r_dir_perms;
allow hal_charger_oplus procfs_oem_wireless:file rw_file_perms;
allow hal_charger_oplus property_socket:sock_file { write };
allow hal_charger_oplus self:netlink_kobject_uevent_socket { bind create getopt read setopt };
allow hal_charger_oplus servicemanager:binder { call transfer };
allow hal_charger_oplus sysfs_battery_supply:dir { open read search };
allow hal_charger_oplus sysfs_battery_supply:file { getattr open read write };
allow hal_charger_oplus sysfs_battery_supply:lnk_file { open read write };
allow hal_charger_oplus sysfs_therm:dir { search };
allow hal_charger_oplus sysfs_therm:file { getattr open read };
allow hal_charger_oplus system_app:binder { transfer };
allow hal_charger_oplus system_server:binder { call transfer };
allow hal_charger_oplus tee_device:chr_file { ioctl open read write };
allow hal_charger_oplus vendor_configs_file:dir { search };
allow hal_charger_oplus vendor_configs_file:file { getattr open read };
allow hal_charger_oplus vendor_proc_charger:dir { search };
allow hal_charger_oplus vendor_proc_charger:file { getattr open read write };
get_prop(hal_charger_oplus, boot_status_prop)
r_dir_file(hal_charger_oplus, oplus_batt_param_proc)
r_dir_file(hal_charger_oplus, sysfs_batteryinfo)
set_prop(hal_charger_oplus, vendor_oplus_prop)

allow hal_charger_oplus oplus_project_proc:file { getattr open read };
