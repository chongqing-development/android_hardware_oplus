# Rules for meta_tst touching device types

allow meta_tst gpsmdl_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow meta_tst gpsstrg_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow meta_tst mtk_usb_offload_device:chr_file { getattr ioctl lock open read watch watch_reads };
allow meta_tst oplus_block_device:blk_file { getattr ioctl lock map open read watch watch_reads write };
allow meta_tst oplus_block_device:dir r_dir_perms;
allow meta_tst oplus_block_device:file { getattr ioctl lock open read watch watch_reads };
allow meta_tst oplus_block_device:lnk_file { getattr ioctl lock open read watch watch_reads };
allow meta_tst oplus_reserve_file:dir { getattr open read search };
allow meta_tst oplus_reserve_radio_file:dir rw_dir_perms;
allow meta_tst oplus_reserve_radio_file:file rw_file_perms;
allow meta_tst proc_clkdbg:file rw_file_perms;
allow meta_tst sysfs_battery_supply:dir r_dir_perms;
allow meta_tst sysfs_battery_supply:file rw_file_perms;
allow meta_tst sysfs_battery_supply:lnk_file r_file_perms;
r_dir_file(meta_tst, proc_opluscustom_file)
set_prop(meta_tst, vendor_oplus_prop)
