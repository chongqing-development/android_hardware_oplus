# hal_oplus_nfc_default - ported from the stock vendor policy

type hal_oplus_nfc_default, domain;
hal_server_domain(hal_oplus_nfc_default, hal_oplus_nfc)

type hal_oplus_nfc_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_oplus_nfc_default)

allow hal_oplus_nfc_default nfc_device:chr_file { ioctl open read write };
allow hal_oplus_nfc_default oplus_nfc_proc:dir r_dir_perms;
allow hal_oplus_nfc_default oplus_nfc_proc:file r_file_perms;
allow hal_oplus_nfc_default oplus_project_proc:dir r_dir_perms;
allow hal_oplus_nfc_default oplus_project_proc:file r_file_perms;
allow hal_oplus_nfc_default vendor_nfc_vendor_data_file:dir { add_name getattr open read remove_name search write };
allow hal_oplus_nfc_default vendor_nfc_vendor_data_file:file { create getattr open read setattr unlink write };
